// Orbit — multi-tenant data model. Every business-data model belongs to an
// Account (the tenant/workspace/billing entity). Enums are modeled as String
// (not Prisma `enum`) — a holdover from when this ran on SQLite, kept for
// schema stability. The canonical value sets live in lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // pooled connection, used at runtime
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used for migrations
}

model Account {
  id                   String    @id @default(cuid())
  name                 String
  // INDIVIDUAL | COMPANY | INFLUENCER | ARTIST | OTHER — collected at
  // signup. Nullable since accounts created before this field existed have
  // no value, not because a new signup can skip choosing one.
  accountType          String?
  planTier             String?   // FREE | BUILDER | GROWTH | AGENCY | null
  subscriptionStatus   String    @default("incomplete") // incomplete | active | trial_expired | past_due | canceled
  // Set once, when the FREE plan is first activated — the 4-day trial
  // window. Left in place after expiry (never cleared/reset) so a re-POST to
  // activate-free can detect "already used" and refuse a second trial on the
  // same account.
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Razorpay Standard Checkout — set once the most recent payment's
  // signature has been verified server-side (never on the client's say-so).
  // billingCurrency comes from Razorpay's own order record at verify time
  // (USD = international track, INR = domestic), not a client-supplied value.
  billingCurrency      String?
  razorpayOrderId      String?
  razorpayPaymentId    String?

  // Automation preferences. autoApproveMode only ever affects 🟢 Auto-tier
  // replies — 🔴 Never-tier items are never touched by this regardless, and
  // posts are always approval-gated by policy (see content-agent.ts).
  // agentCycleTimeSlot picks which of a handful of fixed daily cron slots
  // (see vercel.json) this account's cycle runs in — not an arbitrary time,
  // since Vercel's cron only fires at fixed schedules, not per-account ones.
  autoApproveMode      Boolean   @default(false)
  agentCycleTimeSlot   String    @default("06:00")
  // MANUAL: only the "Run agent cycle" button triggers a cycle, cron skips
  // this account entirely. AUTOMATIC: cron runs it daily at
  // agentCycleTimeSlot instead, and the manual button is hidden.
  cycleMode            String    @default("MANUAL")
  // Set once the post-signup onboarding sequence (knowledge base ->
  // automation preference) has been completed — distinguishes "chose
  // MANUAL deliberately" from "never went through onboarding yet", since
  // MANUAL is itself a valid completed choice, not just an unset default.
  onboardingCompletedAt DateTime?
  // Comma-separated search terms for live conversation discovery
  // (discover-mentions.ts) — proactive keyword search, alongside the
  // account's own X mentions timeline which needs no configuration.
  discoveryKeywords    String?
  // Set right before each Trend Discovery attempt (lib/agents/discover-trends.ts)
  // regardless of outcome — Groq's browser_search tool has no caller-side cap
  // on how many pages it reads per call, so a single call's token cost is
  // unbounded. This is the actual lever available: at most one attempt per
  // account per calendar day, no matter how many times a cycle is triggered.
  lastTrendDiscoveryAt DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users                User[]
  bufferChannels       AccountBufferChannel[]
  socialTokens         AccountSocialToken[]
  mentions             Mention[]
  conversations        Conversation[]
  posts                Post[]
  approvals            Approval[]
  agentRuns            AgentRun[]
  dailySnapshots       DailySnapshot[]
  trendInputs          TrendInput[]
  knowledgeBaseEntries KnowledgeBaseEntry[]
  reels                Reel[]
  carousels            Carousel[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Firebase Auth owns credentials/password policy/breach detection — this
  // is the join key back to that identity. Revocation (password change,
  // suspension) is handled by Firebase's own refresh-token revocation, not a
  // local version counter.
  firebaseUid  String   @unique
  isAdmin      Boolean  @default(false)

  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId])
}

model AccountBufferChannel {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  platform        String   // X | THREADS | LINKEDIN
  bufferChannelId String

  createdAt       DateTime @default(now())

  @@unique([accountId, platform])
}

model AccountSocialToken {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id])
  platform         String   // X only for now — direct OAuth, not Buffer
  // Encrypted (lib/security/token-crypto.ts). OAuth 2.0 Authorization Code
  // + PKCE — access tokens expire (tokenExpiresAt); refreshToken (granted
  // by the offline.access scope) is how a future publish step renews one
  // without asking the user to reconnect.
  accessToken      String
  refreshToken     String
  tokenExpiresAt   DateTime
  externalUserId   String
  externalUsername String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([accountId, platform])
}

model StripeEvent {
  id          String   @id // Stripe's own event id — idempotency guard for webhook redelivery
  processedAt DateTime @default(now())
}

model Mention {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])

  platform       String   @default("X") // X only for now — matches AccountSocialToken
  // The platform's own post id — idempotency key so re-running discovery
  // against overlapping search windows doesn't create duplicate rows for
  // a post already seen.
  platformPostId String
  sourceType     String   // MENTION | KEYWORD_SEARCH — how this was found
  matchedKeyword String?  // which configured keyword matched, if KEYWORD_SEARCH

  authorHandle   String
  authorName     String
  text           String
  likes          Int      @default(0)
  replyCount     Int      @default(0)
  postedAt       DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  conversation   Conversation?

  @@unique([accountId, platformPostId])
  @@index([accountId])
}

model Conversation {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id])

  sourceMentionId  String   @unique
  sourceMention    Mention  @relation(fields: [sourceMentionId], references: [id])

  authorHandle     String
  authorName       String
  originalText     String
  likes            Int      @default(0)
  replyCount       Int      @default(0)

  intent           String   // HIGH | MEDIUM | LOW
  topic            String
  potentialCustomer Boolean @default(false)

  riskTier         String   // AUTO | APPROVAL | NEVER
  matchedKeywords  String? // comma-separated keyword pre-filter hits, if any
  aiRiskReasoning  String?

  aiDraftReply     String?  // null when riskTier = NEVER
  recommendedAction String

  status           String   @default("NEW") // NEW | DRAFTED | REPLIED | IGNORED

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  approvals        Approval[]

  @@index([accountId])
  @@index([status])
  @@index([intent])
  @@index([riskTier])
}

model Post {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id])

  content       String
  platform      String    @default("X")
  status        String    @default("DRAFT") // DRAFT | SCHEDULED | PUBLISHED
  simulated     Boolean   @default(true)
  publishedVia  String?   // BUFFER | X | null
  scheduledFor  DateTime?
  publishedAt   DateTime?
  platformPostId String?
  publishedUrl  String?

  sourceTrendId String?
  sourceTrend   TrendInput? @relation(fields: [sourceTrendId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  approvals     Approval[]

  @@index([accountId, status])
}

model Approval {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])

  type           String   // POST | REPLY | COMMUNITY_INVITE | REEL | CAROUSEL
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | EDITED
  platform       String   @default("X")

  content        String
  editedContent  String?
  aiReasoning    String
  confidence     Float
  riskTier       String   // AUTO | APPROVAL | NEVER

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  postId         String?
  post           Post?    @relation(fields: [postId], references: [id])
  reelId         String?
  reel           Reel?    @relation(fields: [reelId], references: [id])
  carouselId     String?
  carousel       Carousel? @relation(fields: [carouselId], references: [id])

  // Set when this approval was published directly (not via a linked Post) —
  // currently REPLY approvals published through Buffer, which schedules a
  // standalone update rather than an in-thread reply.
  publishedVia   String?  // BUFFER | X | null
  platformPostId String?
  publishedUrl   String?
  scheduledFor   DateTime?
  imageUrl       String?  // LinkedIn only — user-attached while editing, never AI-generated

  resolvedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId, status])
}

model AgentRun {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])

  triggeredBy  String    @default("MANUAL") // MANUAL | CRON
  status       String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  summary      String?
  error        String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([accountId])
}

model DailySnapshot {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])

  date           DateTime
  newFollowers   Int
  waitlistSignups Int
  isDemoData     Boolean  @default(true)

  createdAt      DateTime @default(now())

  @@unique([accountId, date])
}

model TrendInput {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])

  topic           String
  rawSignal       String    // seeded raw context (e.g. a tweet snippet or news blurb)
  source          String    @default("SEED") // SEED | WEB_SEARCH
  summary         String?   // filled in by the Trend Agent
  riskTier        String?   // AUTO | NEVER — keyword-filter result on the trend itself
  matchedKeywords String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  // Null for SEED rows. WEB_SEARCH rows set this to `${idempotencyKey}:${slug}`
  // so a retried discovery run (e.g. a queue job retry) upserts instead of
  // duplicating — a nullable-unique column allows any number of null rows.
  dedupeKey       String?

  posts           Post[]
  reels           Reel[]
  carousels       Carousel[]

  @@unique([accountId, dedupeKey])
  @@index([accountId])
}

model Reel {
  id                 String    @id @default(cuid())
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id])

  mode               String    // PRODUCT_LAUNCH | EDUCATIONAL | TREND_STORY
  // OPPORTUNITY | SCRIPT_OPTIONS | RENDERING | READY | FAILED | APPROVED | REJECTED
  status             String    @default("SCRIPT_OPTIONS")

  // The chosen HeyGen digital-twin avatar (GET /v3/avatars/looks) — set at
  // select-version time, once per Reel. voiceId is that avatar's own
  // default_voice_id, captured alongside it rather than re-fetched at render
  // time, so a picker change doesn't retroactively affect an in-flight Reel.
  avatarId           String?
  voiceId            String?

  title              String?
  // Array of generated script options (label/title/duration/hook/scenes),
  // produced once by reel-script-agent.ts — first Json column in this
  // schema, Postgres supports it natively.
  versions           Json?
  selectedVersionIndex Int?
  // The chosen version's storyboard, copied out of `versions` at
  // select-version time so rendering doesn't depend on `versions` staying
  // unchanged/re-parsed.
  script             Json?

  videoUrl           String?
  thumbnailUrl       String?
  description        String?
  hashtags           String?   // comma-separated, matches discoveryKeywords/matchedKeywords convention

  // HeyGen's own video id (returned synchronously from the submit call) —
  // kept for support/debugging; correlation with the webhook actually
  // happens via callback_id (this row's own id), not this field.
  heygenVideoId      String?

  sourceTrendId      String?
  sourceTrend        TrendInput? @relation(fields: [sourceTrendId], references: [id])

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  approvals          Approval[]

  @@index([accountId, status])
}

model Carousel {
  id                 String    @id @default(cuid())
  accountId          String
  account            Account   @relation(fields: [accountId], references: [id])

  mode               String    // PRODUCT_LAUNCH | EDUCATIONAL | TREND_STORY — same meaning as Reel.mode
  // SCRIPT_OPTIONS | RENDERING | READY | FAILED | APPROVED | REJECTED
  status             String    @default("SCRIPT_OPTIONS")

  title              String?
  // 3 generated slide-copy options (versionA/B/C, each 6 slides), produced
  // once by carousel-script-agent.ts.
  versions           Json?
  selectedVersionIndex Int?
  // The chosen version's 6 slides, copied out of `versions` at
  // select-version time — same pattern as Reel.script.
  slides             Json?
  // 6 Vercel Blob URLs (public PNGs), populated once rendering finishes.
  // Rendering itself is synchronous (next/og ImageResponse, no vendor
  // webhook), so this and `status: READY` are set in the same request that
  // selects a version — unlike Reel, there's no separate async pipeline.
  slideImageUrls     Json?
  description        String?
  hashtags           String?   // comma-separated, matches Reel.hashtags convention

  sourceTrendId      String?
  sourceTrend        TrendInput? @relation(fields: [sourceTrendId], references: [id])

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  approvals          Approval[]

  @@index([accountId, status])
}

model KnowledgeBaseEntry {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])

  // Stable lookup key for entries agents pull in by role (e.g. CONTENT_PILLARS,
  // SAFETY_RULES, BRAND_VOICE, PRODUCT_FEATURES, FOUNDER_STORY). Null for
  // freeform extra entries a tenant adds beyond the standard slots — those
  // just get title-displayed in the UI, not targeted by code.
  key       String?
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}
