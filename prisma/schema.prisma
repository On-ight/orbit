// Orbit — multi-tenant data model. Every business-data model belongs to an
// Account (the tenant/workspace/billing entity). Enums are modeled as String
// (not Prisma `enum`) — a holdover from when this ran on SQLite, kept for
// schema stability. The canonical value sets live in lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // pooled connection, used at runtime
  directUrl = env("DATABASE_URL_UNPOOLED") // direct connection, used for migrations
}

model Account {
  id                   String    @id @default(cuid())
  name                 String
  planTier             String?   // STARTER | GROWTH | AGENCY | null
  subscriptionStatus   String    @default("incomplete") // incomplete | active | past_due | canceled
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Razorpay Standard Checkout — set once the most recent payment's
  // signature has been verified server-side (never on the client's say-so).
  // billingCurrency comes from Razorpay's own order record at verify time
  // (USD = international track, INR = domestic), not a client-supplied value.
  billingCurrency      String?
  razorpayOrderId      String?
  razorpayPaymentId    String?

  // Automation preferences. autoApproveMode only ever affects 🟢 Auto-tier
  // replies — 🔴 Never-tier items are never touched by this regardless, and
  // posts are always approval-gated by policy (see content-agent.ts).
  // agentCycleTimeSlot picks which of a handful of fixed daily cron slots
  // (see vercel.json) this account's cycle runs in — not an arbitrary time,
  // since Vercel's cron only fires at fixed schedules, not per-account ones.
  autoApproveMode      Boolean   @default(false)
  agentCycleTimeSlot   String    @default("06:00")

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  users                User[]
  bufferChannels       AccountBufferChannel[]
  socialTokens         AccountSocialToken[]
  mockMentions         MockMention[]
  conversations        Conversation[]
  posts                Post[]
  approvals            Approval[]
  agentRuns            AgentRun[]
  dailySnapshots       DailySnapshot[]
  trendInputs          TrendInput[]
  knowledgeBaseEntries KnowledgeBaseEntry[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Firebase Auth owns credentials/password policy/breach detection — this
  // is the join key back to that identity. Revocation (password change,
  // suspension) is handled by Firebase's own refresh-token revocation, not a
  // local version counter.
  firebaseUid  String   @unique
  isAdmin      Boolean  @default(false)

  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId])
}

model AccountBufferChannel {
  id              String   @id @default(cuid())
  accountId       String
  account         Account  @relation(fields: [accountId], references: [id])
  platform        String   // X | THREADS | LINKEDIN
  bufferChannelId String

  createdAt       DateTime @default(now())

  @@unique([accountId, platform])
}

model AccountSocialToken {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id])
  platform         String   // X only for now — direct OAuth, not Buffer
  // Encrypted (lib/security/token-crypto.ts). OAuth 2.0 Authorization Code
  // + PKCE — access tokens expire (tokenExpiresAt); refreshToken (granted
  // by the offline.access scope) is how a future publish step renews one
  // without asking the user to reconnect.
  accessToken      String
  refreshToken     String
  tokenExpiresAt   DateTime
  externalUserId   String
  externalUsername String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([accountId, platform])
}

model StripeEvent {
  id          String   @id // Stripe's own event id — idempotency guard for webhook redelivery
  processedAt DateTime @default(now())
}

model MockMention {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])

  authorHandle String
  authorName   String
  text         String
  likes        Int      @default(0)
  replyCount   Int      @default(0)
  postedAt     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversation Conversation?

  @@index([accountId])
}

model Conversation {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id])

  sourceMentionId  String   @unique
  sourceMention    MockMention @relation(fields: [sourceMentionId], references: [id])

  authorHandle     String
  authorName       String
  originalText     String
  likes            Int      @default(0)
  replyCount       Int      @default(0)

  intent           String   // HIGH | MEDIUM | LOW
  topic            String
  potentialCustomer Boolean @default(false)

  riskTier         String   // AUTO | APPROVAL | NEVER
  matchedKeywords  String? // comma-separated keyword pre-filter hits, if any
  aiRiskReasoning  String?

  aiDraftReply     String?  // null when riskTier = NEVER
  recommendedAction String

  status           String   @default("NEW") // NEW | DRAFTED | REPLIED | IGNORED

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  approvals        Approval[]

  @@index([accountId])
  @@index([status])
  @@index([intent])
  @@index([riskTier])
}

model Post {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id])

  content       String
  platform      String    @default("X")
  status        String    @default("DRAFT") // DRAFT | SCHEDULED | PUBLISHED
  simulated     Boolean   @default(true)
  publishedVia  String?   // BUFFER | X | null
  scheduledFor  DateTime?
  publishedAt   DateTime?
  platformPostId String?
  publishedUrl  String?

  sourceTrendId String?
  sourceTrend   TrendInput? @relation(fields: [sourceTrendId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  approvals     Approval[]

  @@index([accountId, status])
}

model Approval {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])

  type           String   // POST | REPLY | COMMUNITY_INVITE
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED | EDITED
  platform       String   @default("X")

  content        String
  editedContent  String?
  aiReasoning    String
  confidence     Float
  riskTier       String   // AUTO | APPROVAL | NEVER

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  postId         String?
  post           Post?    @relation(fields: [postId], references: [id])

  // Set when this approval was published directly (not via a linked Post) —
  // currently REPLY approvals published through Buffer, which schedules a
  // standalone update rather than an in-thread reply.
  publishedVia   String?  // BUFFER | X | null
  platformPostId String?
  publishedUrl   String?
  scheduledFor   DateTime?
  imageUrl       String?  // LinkedIn only — user-attached while editing, never AI-generated

  resolvedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountId, status])
}

model AgentRun {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id])

  triggeredBy  String    @default("MANUAL") // MANUAL | CRON
  status       String    @default("RUNNING") // RUNNING | COMPLETED | FAILED
  summary      String?
  error        String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([accountId])
}

model DailySnapshot {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])

  date           DateTime
  newFollowers   Int
  waitlistSignups Int
  isDemoData     Boolean  @default(true)

  createdAt      DateTime @default(now())

  @@unique([accountId, date])
}

model TrendInput {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id])

  topic           String
  rawSignal       String    // seeded raw context (e.g. a tweet snippet or news blurb)
  source          String    @default("SEED") // SEED | WEB_SEARCH
  summary         String?   // filled in by the Trend Agent
  riskTier        String?   // AUTO | NEVER — keyword-filter result on the trend itself
  matchedKeywords String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  posts           Post[]

  @@index([accountId])
}

model KnowledgeBaseEntry {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])

  // Stable lookup key for entries agents pull in by role (e.g. CONTENT_PILLARS,
  // SAFETY_RULES, BRAND_VOICE, PRODUCT_FEATURES, FOUNDER_STORY). Null for
  // freeform extra entries a tenant adds beyond the standard slots — those
  // just get title-displayed in the UI, not targeted by code.
  key       String?
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
}
